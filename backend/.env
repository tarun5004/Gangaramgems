# Database connection string
# Format: postgresql://user:password@host:port/dbname
# Ye database ka address hai. Isme username, password aur database ka naam hota hai.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gangaramgems_db

# Secret key for signing JWT tokens
# Ye ek secret code hai jo tokens ko secure banata hai. Isse kisi aur ko pata nahi chalna chahiye.
SECRET_KEY=change_this_to_a_very_secure_random_string

# Algorithm used for encryption
# Ye encryption ka tareeka hai.
ALGORITHM=HS256

# Token expiration time in minutes
# Login token kitni der tak valid rahega (yahan 30 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp Number for "Buy Now" feature
# Admin ka WhatsApp number jahan customers message bhejenge.
WHATSAPP_NUMBER=919876543210

# AWS Configuration (For S3 Image Upload)
# AWS ke credentials taaki hum S3 bucket mein images save kar sakein.
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=gangaramgems-images

